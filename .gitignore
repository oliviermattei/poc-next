node_modules/
.env
.env.local
.DS_Store
.worktrees/

# Capture locale des emails : avec `EMAIL_LOCAL_CAPTURE=1`, l'email est écrit
# ici plutôt qu'envoyé. Ce sont des emails de développement, jamais du code.
.mail/

# Stockage sur disque : avec `STORAGE_LOCAL_DIRECTORY=.storage`, les fichiers
# téléversés sont écrits ici plutôt que dans un seau. Ce sont des fichiers de
# développement, jamais du code — et un avatar est une donnée personnelle.
.storage/
# Le stockage du serveur de Playwright, distinct de celui de `pnpm dev`.
.storage-e2e/

# Rapports et traces Playwright
playwright-report/
test-results/
blob-report/
# Les traces du parcours doré, recopiées hors du clone temporaire avant sa
# destruction. Hors de `test-results/`, que `pnpm test:e2e` efface au démarrage.
test-results-parcours-dore/

# Artefacts de build et de cache
.next/
.turbo/
dist/
*.tsbuildinfo

# Réécrit par `next dev` comme par `next build`, avec un chemin différent selon
# la commande. Versionné, il salit l'arbre après chaque build. Les deux
# directives stables qu'il porte vivent dans `apps/web/types/next.d.ts`.
apps/web/next-env.d.ts
