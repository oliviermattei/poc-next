    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "turbo": "^2",
    "typescript": "^5.9.0",
    "vitest": "^4"
